# The repo Dockerfile, but installing a local `npm pack` tarball instead of the published package — this is
# how an unpublished branch, or a package that is packed but not yet published, gets deployed and tested.
#
# The build context is the directory holding the tarball, never the repo: the repo's `.dockerignore` excludes
# `*.tgz`, and this way the repo gains no build file. `scripts/release-check.mjs` copies this file next to the
# tarball and builds from there.
#
#   npm run build && npm pack --pack-destination /tmp/flypi-pack
#   cp docker/Dockerfile.local /tmp/flypi-pack/Dockerfile
#   docker build --build-arg FLYPI_TGZ=makerstufferupper-flypi-<version>.tgz -t flypi:local-<sha> /tmp/flypi-pack

FROM node:24-slim

# The agent has a bash tool, so the tools a turn reaches for are installed the way a developer's shell has
# them: git over https, git-lfs, curl, wget. Slim ships none of them, and git-lfs is only useful with its
# filters registered — the binary alone leaves `git clone` of an LFS repo holding pointer files.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl git git-lfs wget \
	&& git lfs install --system \
	&& rm -rf /var/lib/apt/lists/*

ARG FLYPI_TGZ
RUN test -n "$FLYPI_TGZ" || (echo "build-arg FLYPI_TGZ=<name>.tgz is required" && exit 1)
COPY ${FLYPI_TGZ} /tmp/flypi.tgz
RUN npm install -g --no-audit --no-fund /tmp/flypi.tgz && rm /tmp/flypi.tgz

# Same runtime shape as the published image: a non-root user, /data as the state root, the daemon under PID 1.
RUN groupadd --gid 10001 flypi \
	&& useradd --uid 10001 --gid 10001 --create-home flypi \
	&& mkdir -p /data \
	&& chown flypi:flypi /data
USER flypi
ENV FLYPI_ROOT=/data

EXPOSE 8791
CMD ["flypi", "start", "--foreground", "--port", "8791", "--host", "0.0.0.0"]

{
	"name": "@makerstufferupper/flypi",
	"version": "0.1.8",
	"type": "module",
	"description": "Local multi-model agent tool with a browser UI and a personal knowledge wiki, built on the pi SDK.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/makerstufferupper/flypi.git"
	},
	"bin": {
		"flypi": "bin/flypi.mjs"
	},
	"files": [
		"bin",
		"src",
		"scripts",
		"dist/ui",
		"assets/screenshot.png",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"probe": "tsx scripts/probe.ts",
		"probe:pi": "tsx scripts/probe-pi.ts",
		"probe:turn": "tsx scripts/probe-turn-boundary.ts",
		"probe:boundary": "tsx scripts/turn-boundary.ts",
		"start": "node scripts/start.mjs",
		"dev": "vite",
		"dev:container": "node scripts/dev-container.mjs",
		"models:warm": "tsx scripts/warm-models.ts",
		"build": "vite build",
		"prepublishOnly": "npm run typecheck && npm test && npm run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"record": "tsx scripts/record-transcript.ts",
		"smoke": "tsx scripts/smoke.mjs",
		"smoke:memory": "tsx scripts/smoke-memory.mjs",
		"smoke:secrets": "tsx scripts/smoke-secrets.mjs",
		"secret": "tsx scripts/secret.ts",
		"reembed:memory": "tsx scripts/reembed-memory.ts",
		"memory": "tsx scripts/serve-memory.ts",
		"serve": "tsx scripts/serve.ts",
		"daemon": "tsx scripts/serve-daemon.ts",
		"flypi": "node scripts/flypi.mjs",
		"release": "node scripts/release.mjs",
		"release:check": "node scripts/release-check.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@huggingface/transformers": "^4.3.1",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"marked": "18.0.11",
		"tsx": "^4.23.15",
		"typebox": "^1.3.27",
		"ws": "^8.22.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.4.0",
		"@modelcontextprotocol/server-filesystem": "^1.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.4",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^5.0.3",
		"happy-dom": "^20.14.5",
		"svelte": "^5.57.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"allowScripts": {
		"@google/genai@2.21.0": true,
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true,
		"onnxruntime-node@1.30.0": true,
		"protobufjs@7.6.6": true
	}
}
